# ============================================
# Return Hardener Bottle - Robot Program
# ============================================
# This program picks up the hardener bottle from the workpiece
# position and returns it to storage.
#
# Uses joint positions defined in named_positions.txt
# Joint values are in degrees
# ============================================

# Set a moderate speed for safe operation
set_speed(0.5)

# -----------------------------------------
# Phase 1: Move to Home Position
# -----------------------------------------
movetojoint([55, -90, 90, 180, -90, 0])
wait(1.0)

# Ensure gripper is open before approaching bottle
opengripper
wait(0.5)

# -----------------------------------------
# Phase 2: Move to Hardener Bottle at Workpiece
# -----------------------------------------
movetojoint([33.15, -18.70, 71.4, 130, -70, 0])
wait(0.3)

# -----------------------------------------
# Phase 3: Grasp Bottle
# -----------------------------------------
closegripper
wait(1.0)

# -----------------------------------------
# Phase 4: Return to Home Position
# -----------------------------------------
movetojoint([55, -90, 90, 180, -90, 0])
wait(0.5)

# -----------------------------------------
# Phase 5: Move Above Hardener Storage
# -----------------------------------------
movetojoint([-9.4, -33.23, 76.61, 139.04, -115.9, 0])
wait(0.5)

# -----------------------------------------
# Phase 6: Lower to Hardener Storage Position
# -----------------------------------------
movetojoint([-11.27, -25.22, 78.85, 136.04, -111.82, 0])
wait(0.3)

# -----------------------------------------
# Phase 7: Release Bottle
# -----------------------------------------
opengripper
wait(1.0)

# -----------------------------------------
# Phase 8: Retreat and Return Home
# -----------------------------------------
# Lift up (go back to above position)
movetojoint([-9.4, -33.23, 76.61, 139.04, -115.9, 0])
wait(0.5)

# Return to Home position
movetojoint([55, -90, 90, 180, -90, 0])
wait(0.5)

# Program complete!
# The hardener bottle has been returned to storage.
