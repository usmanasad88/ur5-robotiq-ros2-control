# Place an object currently held by the gripper at a named position.
#
# Usage:
#   place_object[TargetName, SafeName]
#   place_object[object=TargetName, safe=SafeName]
#
# Assumes the object is already grasped. The robot moves to the safe position
# first, then descends onto the target, opens the gripper, and retreats.
# args: object, safe

set_speed(0.3)

if not_near({safe}, 0.15)
  movetonamed({safe})
  wait(0.5)
endif

set_speed(0.5)

moverelative({object}, up, 0.15)
wait(0.3)

movetonamed({object})
wait(0.3)

opengripper
wait(0.5)

moverelative({object}, up, 0.15)
wait(0.3)

set_speed(0.3)
movetonamed({safe})
wait(0.5)
