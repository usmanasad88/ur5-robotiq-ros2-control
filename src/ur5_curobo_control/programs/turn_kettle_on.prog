# Switch the kettle on to start boiling (the blue LED turns on).
#
# Usage:
#   turn_kettle_on[safe]
#   turn_kettle_on[safe=Home]
#
# Mapped from the robot_skills.json `turn_kettle_on` skill.
# Preconditions (planner-enforced): lid is CLOSED and water is in the kettle.
#
# Behaviour:
#   1. Start from the safe pose with the gripper closed (compact tool tip).
#   2. Move above the kettle power switch.
#   3. Push the switch down/in to turn the kettle on.
#   4. Retreat back up to the approach pose and return to the safe pose.
# args: safe

set_speed(0.4)

# --- Start from a known safe pose ---
if not_near({safe}, 0.15)
  movetonamed({safe})
  wait(0.5)
endif

# Close the gripper so the end-effector is a compact tip for pressing
if gripper_open
  closegripper
  wait(0.5)
endif

# --- Approach above the power switch ---
set_speed(0.3)
movetonamed(Kettle_Switch_Above)
wait(0.5)

# --- Press the switch to turn the kettle on ---
set_speed(0.15)
movetonamed(Kettle_Switch_On)
wait(1.0)

# --- Retreat straight back up to the approach pose (clear of the switch) ---
set_speed(0.3)
movetonamed(Kettle_Switch_Above)
wait(0.3)

# --- Return to safe ---
movetonamed({safe})
wait(0.5)
