# ============================================
# Move Hardener from Workplace to Storage - Robot Program
# ============================================
# This program picks up the hardener bottle from the workpiece
# position and returns it to storage using named
# joint positions.
# ============================================

# Set a moderate speed for safe operation
set_speed(0.5)

# -----------------------------------------
# Phase 1: Move to Home Position
# -----------------------------------------
movetonamed(Home)
wait(1.0)

# Ensure gripper is open before approaching bottle
opengripper
wait(0.5)

# -----------------------------------------
# Phase 2: Pick Bottle from Workplace
# -----------------------------------------
movetonamed(Above_Bottle_Hardener_Workspace)
wait(0.5)
movetonamed(Bottle_Hardener_Workspace)
wait(0.3)
closegripper
wait(1.0)
movetonamed(Above_Bottle_Hardener_Workspace)
wait(0.5)

# -----------------------------------------
# Phase 3: Move to Storage and Place Bottle
# -----------------------------------------
movetonamed(Above_Bottle_Hardener_Storage)
wait(0.5)
movetonamed(Bottle_Hardener_Storage)
wait(0.3)
opengripper
wait(1.0)
movetonamed(Above_Bottle_Hardener_Storage)
wait(0.5)

# -----------------------------------------
# Phase 4: Return Home
# -----------------------------------------
movetonamed(Home)
wait(0.5)

# Program complete!

