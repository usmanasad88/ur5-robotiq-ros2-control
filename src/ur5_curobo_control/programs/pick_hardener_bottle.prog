# ============================================
# Pick Hardener Bottle - Robot Program
# ============================================
# This program picks up the hardener bottle from storage
# and moves it to the workpiece position.
#
# Uses joint positions defined in named_positions.txt
# Joint values are in degrees
# ============================================

# Set a moderate speed for safe operation
set_speed(0.5)

# -----------------------------------------
# Phase 1: Move to Home Position
# -----------------------------------------
movetojoint([55, -90, 90, 180, -90, 0])
wait(1.0)

# Ensure gripper is open before approaching bottle
opengripper
wait(0.5)

# -----------------------------------------
# Phase 2: Move Above Hardener Bottle Storage
# -----------------------------------------
movetojoint([-9.4, -33.23, 76.61, 139.04, -115.9, 0])
wait(0.5)

# -----------------------------------------
# Phase 3: Lower to Hardener Bottle Storage
# -----------------------------------------
movetojoint([-11.27, -25.22, 78.85, 136.04, -111.82, 0])
wait(0.3)

# -----------------------------------------
# Phase 4: Grasp Bottle
# -----------------------------------------
closegripper
wait(1.0)

# -----------------------------------------
# Phase 5: Lift and Return to Home
# -----------------------------------------
# First lift up (go back to above position)
movetojoint([-9.4, -33.23, 76.61, 139.04, -115.9, 0])
wait(0.5)

# Move to Home position
movetojoint([55, -90, 90, 180, -90, 0])
wait(0.5)

# -----------------------------------------
# Phase 6: Move Above Hardener Workpiece Position
# -----------------------------------------
movetojoint([33.15, -28.0, 75.0, 135, -70, 0])
wait(0.5)

# -----------------------------------------
# Phase 7: Lower to Hardener Workpiece Position
# -----------------------------------------
movetojoint([33.15, -18.70, 71.4, 130, -70, 0])
wait(0.3)

# -----------------------------------------
# Phase 8: Release Bottle
# -----------------------------------------
opengripper
wait(0.5)

# -----------------------------------------
# Phase 9: Lift Up and Return Home
# -----------------------------------------
movetojoint([33.15, -28.0, 75.0, 135, -70, 0])
wait(0.5)

movetojoint([55, -90, 90, 180, -90, 0])
wait(0.5)

# Program complete!
# The hardener bottle is now at the workpiece position.
