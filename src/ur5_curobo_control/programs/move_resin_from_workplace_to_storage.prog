# ============================================
# Move Resin from Workplace to Storage
# ============================================

set_speed(0.5)

# -----------------------------------------
# Phase 1: Ensure we start from Home
# -----------------------------------------
if not_near(Home, 0.15)
  movetonamed(Home)
  wait(1.0)
endif

# -----------------------------------------
# Phase 2: Ensure gripper is open
# -----------------------------------------
if gripper_closed
  opengripper
  wait(0.5)
endif

# -----------------------------------------
# Phase 3: Move to resin bottle workspace (source)
# -----------------------------------------
moverelative(Bottle_Resin_Workspace, up, 0.15)
wait(0.5)

movetonamed(Bottle_Resin_Workspace)
wait(0.3)

# -----------------------------------------
# Phase 4: Grasp the bottle
# -----------------------------------------
closegripper
wait(1.0)

# -----------------------------------------
# Phase 5: Lift up and return home via named positions
# -----------------------------------------
moverelative(Bottle_Resin_Workspace, up, 0.15)
wait(0.5)

set_speed(0.3)

movetonamed(Home)
wait(0.5)

set_speed(0.5)

# -----------------------------------------
# Phase 6: Move to storage position (target)
# -----------------------------------------
moverelative(Bottle_Resin_Storage, up, 0.15)
wait(0.5)

movetonamed(Bottle_Resin_Storage)
wait(0.3)

# -----------------------------------------
# Phase 7: Release bottle
# -----------------------------------------
opengripper
wait(0.5)

# -----------------------------------------
# Phase 8: Small retreat using relative motion
# -----------------------------------------
moverelative(Bottle_Resin_Storage, up, 0.15)
wait(0.3)

set_speed(0.3)

# -----------------------------------------
# Phase 9: Return home
# -----------------------------------------
movetonamed(Home)
wait(0.5)
