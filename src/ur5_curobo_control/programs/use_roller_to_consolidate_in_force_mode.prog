# ============================================
# Move Roller from Storage to Workplace - Robot Program
# ============================================
# This program picks up the roller from storage
# and moves it to the workpiece position using named
# joint positions.
# ============================================

# Set a moderate speed for safe operation
set_speed(0.5)

# -----------------------------------------
# Phase 1: Move to Home Position
# -----------------------------------------
# Skip if already at Home
if near(Home)
  wait(0.1)
else
  movetonamed(Home)
  wait(1.0)
endif

# Ensure gripper is open before approaching roller
if gripper_open
  wait(0.1)
else
  opengripper
  wait(0.5)
endif

# -----------------------------------------
# Phase 2: Approach and Pick Roller from Storage
# -----------------------------------------
# Move to a safe position above the roller
movetonamed(Roller_Storage_Above)
wait(0.5)

# Lower to grasp the roller
movetonamed(Roller_Storage_Pick)
wait(0.3)

# Grasp Roller
closegripper
wait(1.0)

# -----------------------------------------
# Phase 3: Lift and Move to Workpiece Area
# -----------------------------------------
# Lift the roller straight up
movetonamed(Roller_Storage_Above)
wait(0.5)
set_speed(0.2)

movetonamed(Home)
wait(0.5)
set_speed(0.5)

force_mode([0,0,1,0,0,0], [0,0,10,0,0,0], 0.05)

# Sweep using movel with direction vectors (works during force mode)
# movel([x,y,z], distance_m, speed_m/s)
movel(down, 0.5, 0.05)
movel(forward, 0.15, 0.05)
movel(back, 0.15, 0.05)
movel(forward, 0.15, 0.05)
movel(back, 0.15, 0.05)

# Stop force mode
force_mode_stop()
wait(0.5)


# -----------------------------------------
# Phase 4: Place Roller back at Storage Position
# -----------------------------------------
# -----------------------------------------
# Lower to the workpiece position

# Return to Home position
movetonamed(Home)
wait(0.5)

movetonamed(Roller_Storage_Above)
movetonamed(Roller_Storage_Pick)

# Release Roller
opengripper
movetonamed(Roller_Storage_Above)
wait(0.5)
set_speed(0.3)
movetonamed(Home)


# Program complete!
# The roller is now at the workpiece position.
